{
  "name": "dsh-novel-memory",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "description": "七层小说记忆：读一遍，丢掉原文也能讨论剧情、续写、查细节。",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:xyf216865/dsh-novel-memory.git"
  }
}
